{
  "name": "kyc-onboarding-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate": "tsx src/cli.ts migrate",
    "review": "tsx src/cli.ts review",
    "demo": "tsx src/cli.ts demo",
    "db:local": "tsx src/local-db.ts",
    "format": "prettier --write src test package.json tsconfig.json"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^18.1.0-beta.15",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
