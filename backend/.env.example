NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://kyc:local-development-only@localhost:5432/kyc
# Generate each separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-with-random-32-byte-base64
TOKEN_PEPPER=replace-with-random-32-byte-base64
MEDIA_ENCRYPTION_KEY=replace-with-random-32-byte-base64
MEDIA_DIR=./media
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=KYC Demo <no-reply@kyc.example>
RESET_LINK=kycapp://app/reset-password
# Optional production SMTP authentication:
# SMTP_USER=
# SMTP_PASSWORD=
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_MAX=12

# OCR and selfie/document comparison: none, local, or aws.
# Local: run python3 scripts/setup-local-verification.py from the repo root first.
# AWS: configure backend-only credentials (IAM role/profile/standard AWS env).
KYC_VERIFICATION_PROVIDER=none
# KYC_LOCAL_PYTHON=/absolute/path/backend/.local/identity-venv/bin/python
# KYC_LOCAL_MODELS_DIR=/absolute/path/backend/.local/identity-models
# OCR default is vie; alternatives: eng, vie+eng, eng+vie.
# KYC_LOCAL_OCR_LANGUAGES=vie
# AWS_REGION=ap-southeast-1
# AWS_PROFILE=kyc-development
# Leave unset for provider defaults: local=36.3, aws=90. Scores are not comparable.
# KYC_FACE_MATCH_THRESHOLD=36.3
KYC_VERIFICATION_TIMEOUT_MS=7000

