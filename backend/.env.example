NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://kyc:local-development-only@localhost:5432/kyc
# Generate each separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-with-random-32-byte-base64
TOKEN_PEPPER=replace-with-random-32-byte-base64
MEDIA_ENCRYPTION_KEY=replace-with-random-32-byte-base64
MEDIA_DIR=./media
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=KYC Demo <no-reply@kyc.example>
RESET_LINK=kycapp://app/reset-password
# Optional production SMTP authentication:
# SMTP_USER=
# SMTP_PASSWORD=
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_MAX=12

